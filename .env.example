# Copy to .env and export the values in your shell (the app reads plain
# environment variables and does not load .env files by itself).
# Every value here is optional in dev. With nothing set the app runs fully
# offline with a fake bot token and the mock sender.

# dev or prod. prod refuses to start with the fake token or without a staff list.
APP_ENV=dev

# Bot token from BotFather. Used only to verify init data signatures.
# Leave empty in dev to use the built in fake token.
TELEGRAM_BOT_TOKEN=

# Comma separated Telegram user ids allowed to use the desk. Required in prod.
# Example: STAFF_TELEGRAM_IDS=1001,1002
STAFF_TELEGRAM_IDS=

# How old signed init data may be, in seconds.
INIT_DATA_MAX_AGE_SECONDS=3600

# true means the person who wrote a version cannot be the one who approves it.
REQUIRE_SECOND_APPROVER=false

# Only "mock" is implemented.
SMS_PROVIDER=mock

# Longest text a reviewer may save.
MAX_BODY_CHARS=480

# SQLite file. The folder is created on first start.
DESK_DB_PATH=data/desk.sqlite3
